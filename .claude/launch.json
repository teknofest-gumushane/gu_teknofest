{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web-build",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8090",
        "--bind",
        "127.0.0.1",
        "--directory",
        "build/web"
      ],
      "port": 8090
    },
    {
      "name": "web-dev",
      "runtimeExecutable": "flutter",
      "runtimeArgs": [
        "run",
        "-d",
        "web-server",
        "--web-port=8091",
        "--web-hostname=127.0.0.1",
        "--dart-define=ENV=mock"
      ],
      "port": 8091
    }
  ]
}
